# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# Script database mode:
# WORDLESS_USE_LOCAL_DB=1
# WORDLESS_LOCAL_DB_PATH=db/wordless-local.db

# Strands 谜题生成脚本的 LLM 配置（scripts/lib/strands-llm.js）
# 方案 A（推荐，便宜）：硅基流动 —— 规格 §6 参考实现平台，填下面三个变量即整体切换
#   STRANDS_LLM_BASE_URL=https://api.siliconflow.cn/v1
#   STRANDS_LLM_API_KEY=<硅基流动 API Key>
#   STRANDS_LLM_MODEL=deepseek-ai/DeepSeek-V3        # 更省可用 Qwen/Qwen2.5-7B-Instruct
# 方案 B：不配 STRANDS_LLM_*，回退到下面的豆包（火山方舟）共享配置
# NEXT_PUBLIC_DOUBAO_BASE_URL=
# NEXT_PUBLIC_DOUBAO_OPENAI_API_KEY=
# chat 模型推荐 doubao-seed-evolving（固定 Model ID，官方周级自动升级到最强 Seed 版本，
# 无旧版本下线迁移成本）；也可用 doubao-seed-2.1-turbo 等文本模型或自建 ep- 接入点 ID
# NEXT_PUBLIC_DOUBAO_LINK_128K_MODEL=doubao-seed-evolving
# 主题语义去重的向量模型（可选，跟随上面选定的平台）：
#   硅基流动：BAAI/bge-m3（1024 维，走 /embeddings）
#   火山方舟：doubao-embedding-text-240515（2048 维，走 /embeddings）
#           doubao-embedding-vision-251215（2048 维，多模态，代码自动切 /embeddings/multimodal）
# 不配置则语义去重降级为精确字符串匹配。
# STRANDS_EMBEDDING_MODEL=
# 可选：强制校验向量维度（默认不校验，接受模型原生维度）
# STRANDS_EMBEDDING_DIMENSION=1024
# 可选：开启 chat 模型的深度思考（仅火山方舟生效，默认关闭——思考链会把响应拖过 180s 超时）
# STRANDS_LLM_ENABLE_THINKING=1
